# classic PAT with the `notifications` scope (or `repo`). Fine-grained tokens
# do NOT work with the notifications endpoints.
GITHUB_TOKEN="ghp_xxx"

APP_PORT=80
APP_ENV="development"

# floor between polls; raised to X-Poll-Interval when GitHub asks for more.
POLL_INTERVAL_SECONDS=60

# comma-separated globs of repos to act on.
REPO_FILTER="wajeht/*"

# fast-path title heuristic (used unless STRICT_AUTHOR_CHECK=true).
RENOVATE_TITLE_REGEX="(?i)^(update|chore\(deps|fix\(deps|pin dependencies|lock file maintenance)"

# strict path: dereference each candidate PR and require a known bot author.
STRICT_AUTHOR_CHECK=false
RENOVATE_BOT_LOGINS="renovate[bot]"

# done = DELETE thread (GitHub "Done" tab); read = PATCH thread (mark read).
MARK_MODE="done"

# log what would be cleared without touching anything. Use first.
DRY_RUN=true

# optional allowlist of notification reasons, e.g. "review_requested,subscribed".
ONLY_REASONS=""
