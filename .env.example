# classic PAT with the notifications scope. Fine-grained tokens do NOT work with
# the notifications endpoints.
GITHUB_TOKEN="ghp_xxx"

# port for the /healthz endpoint used by the docker healthcheck.
APP_PORT=80

# seconds between polls.
POLL_INTERVAL_SECONDS=60

# comma-separated repo globs to act on.
REPO_FILTER="wajeht/*"

# comma-separated PR-author logins treated as Renovate, matched case-insensitively.
RENOVATE_BOT_LOGINS="wajeht-renovate,wajeht-renovate[bot]"

# done deletes the thread, read marks it read.
MARK_MODE="done"

# log what would be cleared without touching anything. Use first.
DRY_RUN=true
